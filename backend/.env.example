# Stage C Environment Configuration
# Copy this file to .env for local overrides

# HTTP Server Port
PORT=8000

# Allowed Frontend CORS Origin (Vite default dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Stage C Development Identity (Matches fixture demo user "asha")
DEMO_USER_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# Simulated I/O latency in milliseconds for async concurrency tests (0-1000)
SIMULATED_IO_MS=0

# Async PostgreSQL Database Connection URL (Target: instagram_modeling)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/instagram_modeling

# Database Connection Timeout in Milliseconds
DATABASE_CONNECT_TIMEOUT_MS=5000
